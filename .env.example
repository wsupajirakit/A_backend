# Copy to .env and fill in. Never commit .env.

APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
# Public site origin, used to build image URLs (no trailing slash).
PUBLIC_BASE_URL=https://www.example.com
# Set true only behind a reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY=false
# Optional; defaults to ./storage
STORAGE_PATH=

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aradio
DB_USER=aradio_app
DB_PASS=change-me

# Mobile API: JSON object {"<app id>": "<secret>"}; use long random secrets.
MOBILE_APP_KEYS={"aradio-ios":"replace-with-random-secret","aradio-android":"replace-with-random-secret"}
RATE_LIMIT_PER_MINUTE=120

# Radio stream
STREAM_URL=https://stream.example.com/live

# Admin panel
ADMIN_IDLE_TIMEOUT=1800
ADMIN_LOGIN_MAX_ATTEMPTS=5

# SMTP for admin password reset
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="A Radio"
